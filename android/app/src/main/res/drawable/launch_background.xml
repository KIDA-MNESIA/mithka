<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start splash background. @color/launch_background is night-qualified
     (values/ and values-night/) so the starting window follows the system
     appearance instead of flashing white in dark mode, and it equals the app's
     own surface so removing the splash when Flutter draws its first frame is
     not visible. Keep it in sync with AppColors.background and the iOS
     LaunchBackground color set; test/launch_background_test.dart pins them. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />

    <!-- You can insert your own image assets here -->
    <!-- <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/launch_image" />
    </item> -->
</layer-list>
